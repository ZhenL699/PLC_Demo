<Window x:Class="PLC_Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PLC_Control"
        mc:Ignorable="d"
        Title="PLC 控制演示"
        Height="520"
        Width="560"
        Closing="MainWindow_OnClosing">
    <DockPanel Margin="12">
        <TextBlock x:Name="StatusTextBlock"
                   DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="未连接" />

        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="逻辑站号：" />
            <TextBox x:Name="StationTextBox"
                     Width="80"
                     VerticalAlignment="Center"
                     Text="1" />
            <Button x:Name="ConnectButton"
                    Margin="16,0,8,0"
                    Padding="12,4"
                    Content="连接"
                    Click="ConnectButton_Click" />
            <Button x:Name="DisconnectButton"
                    Padding="12,4"
                    Content="断开"
                    Click="DisconnectButton_Click" />
        </StackPanel>

        <GroupBox Header="定位操作"
                  Margin="0,8,0,0">
            <StackPanel Margin="8">
                <Button x:Name="SetZeroButton"
                        Margin="0,4"
                        Content="设定原点"
                        Click="SetZeroButton_Click" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock VerticalAlignment="Center" Text="频率值 D0：" />
                    <TextBox x:Name="FrequencyTextBox"
                             Width="120"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Text="2" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock VerticalAlignment="Center" Text="目标位置 D1：" />
                    <TextBox x:Name="TargetPositionTextBox"
                             Width="120"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Text="0" />
                </StackPanel>
                <Button x:Name="MoveButton"
                        Margin="0,8,0,0"
                        Content="正向移动"
                        Click="MoveButton_Click" />
                <Button x:Name="BackMoveButton"
                        Margin="0,8,0,0"
                        Content="反向移动"
                        Click="BackMoveButton_Click" />
                <Button x:Name="ResetZeroFlagButton"
                        Margin="0,8,0,0"
                        Content="紧急停止"
                        Click="ResetZeroFlagButton_Click" />
                <TextBlock Margin="0,12,0,0"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="说明：移动与回原点需先完成「设定原点」且 PLC 侧 M10=ON。清除原点标志通过写 M3 触发梯形图复位 M10（依你的梯形图逻辑）。" />
            </StackPanel>
        </GroupBox>
    </DockPanel>
</Window>
